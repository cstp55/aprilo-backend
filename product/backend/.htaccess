Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep Laravel's project files from being served directly.
    RewriteRule ^(?:\.env|composer\.(?:json|lock)|artisan|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]

    # Forward the cPanel document root into Laravel's public directory.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

DirectoryIndex public/index.php
