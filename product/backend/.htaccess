Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive Laravel files/directories
    RewriteRule ^(?:\.env|composer\.(?:json|lock)|artisan|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]

    # Homepage: directly load Laravel public/index.php
    RewriteRule ^$ public/index.php [L]

    # All other requests: internally forward to public/
    RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>